# Set a unique secret in the deployment environment; never commit the real value.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: seed an admin only when both username and password are set.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# Public backend URL used for email verification links.
APP_BASE_URL=http://127.0.0.1:8000

# Optional SMTP configuration. Without it, registrations are auto-verified.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=
